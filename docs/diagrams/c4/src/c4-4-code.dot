      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">providers/: ConvexClientProvider · QueryClientProvider · ThemeProvider</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">constants/common.ts · interfaces/NavigationItem.ts</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_convex {
    label="Backend chính — convex/ (TypeScript)"; labeljust="l"; fontsize=14; fontcolor="#444444";
    style="rounded,filled"; fillcolor="#fffaf0"; color="#b06000"; penwidth=1.6; margin=14;

    c_schema [fillcolor="#f5c78a", fontcolor="#1b1b1b", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
