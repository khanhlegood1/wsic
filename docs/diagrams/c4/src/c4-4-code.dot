digraph c4_l4 {
  graph [
    rankdir=LR, fontname="DejaVu Sans", fontsize=23, labelloc="t", labeljust="c",
    label="C4 · Cấp 4 — Sơ đồ mã nguồn (Code) · bản đồ tệp & ký hiệu chính của WSIC\nCột trái → phải: ứng dụng web → backend Convex → Python (điều phối + tác tử) → cấu hình & tài liệu",
    bgcolor="#ffffff", pad=0.5, nodesep=0.35, ranksep=0.9, compound=true, newrank=true
  ];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#ffffff", penwidth=0, margin="0.16,0.1"];
  edge [fontname="DejaVu Sans", fontsize=9.5, color="#707070", penwidth=1.2, arrowsize=0.65, fontcolor="#4d4d4d"];

  subgraph cluster_web {
    label="Ứng dụng web — Next.js 16 (TypeScript)"; labeljust="l"; fontsize=14; fontcolor="#444444";
    style="rounded,filled"; fillcolor="#f4f9ff"; color="#438dd5"; penwidth=1.6; margin=14;

    f_app [fillcolor="#85bbf0", fontcolor="#1b1b1b", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><B>app/</B> — định tuyến &amp; trang (App Router)</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">layout.tsx · page.tsx · error.tsx · not-found.tsx</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">login/{layout,page}.tsx · user/{dashboard,search,explore,</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">saved,profile,notes,communities}/ · topic/[id]/</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">api/auth/[...all]/route.ts · api/queue-topic-request/route.ts</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">api/health/auth/route.ts</FONT></TD></TR></TABLE>>];
    f_proxy [fillcolor="#85bbf0", fontcolor="#1b1b1b", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><B>proxy.ts</B> (gốc dự án)</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">proxy(request) · config.matcher</FONT></TD></TR></TABLE>>];
    f_components [fillcolor="#85bbf0", fontcolor="#1b1b1b", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><B>components/</B> — UI</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">pages/: Home · SearchResults · Topic · Explore</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">  · Category · Saved · Profile</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">content/: Block · MultiQuiz · Reorder · Summary</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">  · SimilarTopics · SuggestedTopics · TrendingTopics</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">  · TopicGrid · CategoryCard · SelectHolder</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">layout/: TopBar · Footer · Notification · ThemeToggle</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">navigation/: NavigationSidebar · MobileBottomNavigation</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">features/: TopicSearch · SubscriptionCard</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">auth/: GoogleSignInButton · AnonymousHelpDialog</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ui/: button · input · dialog · avatar · select … (shadcn)</FONT></TD></TR></TABLE>>];
    f_hooks [fillcolor="#85bbf0", fontcolor="#1b1b1b", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><B>hooks/</B> — cầu nối dữ liệu</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">useTopics · useTopic · useTrendingTopics · useUserTopics</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">useTopicInteractions · useNotifications · useTopBarVisibility</FONT></TD></TR></TABLE>>];
