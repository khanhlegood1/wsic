      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">  · deleteTopic · triggerTrendingUpdate</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">internal: updateTrendingStatus (tính điểm trending)</FONT></TD></TR></TABLE>>];
    c_search [fillcolor="#f5c78a", fontcolor="#1b1b1b", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><B>search.ts</B> · <B>embeddings.ts</B> — tìm kiếm</TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">simpleSearchTopics (searchIndex “search_topics”)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">getSimilarTopics · searchSimilarTopicsByTerm (action)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">getTopicEmbedding(Internal) · getTopicsByEmbeddingIds(Internal)</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">createEmbedding · deleteEmbedding(sByTopic) · generateEmbedding()</FONT></TD></TR></TABLE>>];
    c_other [fillcolor="#f5c78a", fontcolor="#1b1b1b", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0">
      <TR><TD ALIGN="LEFT"><B>blocks · categories · users · notifications · constants · seed · crons · types</B></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">blocks.ts: getBlocksByTopic(id) · createBlock · deleteBlock</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">categories.ts: getCategories · getCategoryBySlug · createCategory</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">users.ts: recordInteraction · getSavedTopics · getUserTopics</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">notifications.ts: createNotification · getUserNotifications</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">constants.ts: initializeNotificationTypes · getNotificationTypes</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">seed.ts: seedCategories · seedNotificationTypes · initializeDatabase</FONT></TD></TR>
      <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">crons.ts: “update trending status” mỗi 1 giờ</FONT></TD></TR></TABLE>>];
  }

  subgraph cluster_py {
    label="Python — điều phối &amp; tác tử"; labeljust="l"; fontsize=14; fontcolor="#444444";
